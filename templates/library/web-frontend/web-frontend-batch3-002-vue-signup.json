  "code": "<script setup>\nimport { ref, computed } from 'vue'\nconst name = ref('')\nconst email = ref('')\nconst pwd = ref('')\nconst pwd2 = ref('')\nconst match = computed(() => pwd.value === pwd2.value)\nasync function submit() {\n  if (!match.value) return\n  await fetch('{{endpoint}}', {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({ name: name.value, email: email.value, password: pwd.value })\n  })\n}\n</script>\n<template>\n  <form @submit.prevent=\"submit\">\n    <input v-model=\"name\" placeholder=\"Name\" required />\n    <input v-model=\"email\" type=\"email\" placeholder=\"Email\" required />\n    <input v-model=\"pwd\" type=\"password\" placeholder=\"Password\" required />\n    <input v-model=\"pwd2\" type=\"password\" placeholder=\"Confirm\" required />\n    <p v-if=\"!match && pwd2\">Passwords do not match</p>\n    <button :disabled=\"!match\">Create account</button>\n  </form>\n</template>",
  "language": "vue",
  "deps": [
    "vue"
  ],
  "summary_zh": "Vue 註冊表單含密碼確認驗證"
