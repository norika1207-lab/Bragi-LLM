  "code": "<script setup>\nimport { ref } from 'vue'\nconst expr = ref('')\nconst result = ref('')\nfunction press(k) { expr.value += k }\nfunction clear() { expr.value = ''; result.value = '' }\nfunction calc() {\n  try { result.value = String(Function('return ' + expr.value)()) }\n  catch { result.value = 'Err' }\n}\n</script>\n<template>\n  <div class=\"calc\">\n    <h3>{{title}}</h3>\n    <div class=\"display\">{{ expr || '0' }} = {{ result }}</div>\n    <div class=\"keys\">\n      <button v-for=\"k in ['7','8','9','/','4','5','6','*','1','2','3','-','0','.','+']\" :key=\"k\" @click=\"press(k)\">{{ k }}</button>\n      <button @click=\"clear\">C</button>\n      <button @click=\"calc\">=</button>\n    </div>\n  </div>\n</template>",
  "language": "vue",
  "deps": [
    "vue"
  ],
  "summary_zh": "Vue 簡易計算機元件"
}