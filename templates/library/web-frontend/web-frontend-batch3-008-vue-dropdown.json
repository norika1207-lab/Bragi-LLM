  "code": "<script setup>\nimport { ref, onMounted, onUnmounted } from 'vue'\nconst props = defineProps({ {{options_var}}: { type: Array, required: true } })\nconst open = ref(false)\nconst selected = ref(null)\nconst root = ref(null)\nfunction onClick(e) { if (root.value && !root.value.contains(e.target)) open.value = false }\nonMounted(() => document.addEventListener('click', onClick))\nonUnmounted(() => document.removeEventListener('click', onClick))\n</script>\n<template>\n  <div ref=\"root\" class=\"dd\">\n    <button @click=\"open = !open\">{{ selected || 'Select' }}</button>\n    <ul v-if=\"open\">\n      <li v-for=\"o in {{options_var}}\" :key=\"o\" @click=\"selected = o; open = false\">{{ o }}</li>\n    </ul>\n  </div>\n</template>",
