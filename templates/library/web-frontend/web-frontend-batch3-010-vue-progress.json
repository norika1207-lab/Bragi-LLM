  "code": "<script setup>\ndefineProps({ value: { type: Number, default: 0 }, max: { type: Number, default: 100 } })\n</script>\n<template>\n  <div class=\"bar\">\n    <div class=\"fill\" :style=\"{ width: (value/max*100) + '%' }\"></div>\n    <span>{{ Math.round(value/max*100) }}%</span>\n  </div>\n</template>\n<style scoped>\n.bar { position: relative; background: #eee; height: 20px; border-radius: 10px; overflow: hidden; }\n.fill { background: {{color}}; height: 100%; transition: width .3s; }\nspan { position: absolute; inset: 0; text-align: center; font-size: 12px; }\n</style>",
