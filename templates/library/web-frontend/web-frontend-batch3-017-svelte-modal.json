  "code": "<script>\n  import { createEventDispatcher } from 'svelte';\n  export let open = false;\n  export let title = '{{title}}';\n  const dispatch = createEventDispatcher();\n</script>\n{#if open}\n  <div class=\"backdrop\" on:click|self={() => dispatch('close')}>\n    <div class=\"modal\">\n      <header><h3>{title}</h3><button on:click={() => dispatch('close')}>x</button></header>\n      <slot />\n    </div>\n  </div>\n{/if}\n<style>\n  .backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: flex; align-items: center; justify-content: center; }\n  .modal { background: white; padding: 1.5rem; border-radius: 8px; min-width: 320px; }\n</style>",
  "language": "svelte",
