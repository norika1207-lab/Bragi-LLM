  "code": "<script>\n  import { tweened } from 'svelte/motion';\n  import { cubicOut } from 'svelte/easing';\n  export let value = 0;\n  export let max = 100;\n  const progress = tweened(0, { duration: 400, easing: cubicOut });\n  $: progress.set(value / max * 100);\n</script>\n<div class=\"bar\">\n  <div class=\"fill\" style=\"width: {$progress}%\"></div>\n  <span>{Math.round($progress)}%</span>\n</div>\n<style>\n  .bar { position: relative; background: #eee; height: 20px; border-radius: 10px; overflow: hidden; }\n  .fill { background: {{color}}; height: 100%; }\n  span { position: absolute; inset: 0; text-align: center; font-size: 12px; }\n</style>",
  "language": "svelte",
  "deps": [
    "svelte"
  ],
  "summary_zh": "Svelte tweened 動畫進度條"
}