  "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><title>Login</title>\n<style>\n  body { font-family: system-ui; display: grid; place-items: center; min-height: 100vh; }\n  form { display: flex; flex-direction: column; gap: .75rem; min-width: 300px; }\n  input, button { padding: .6rem; font-size: 1rem; }\n  button { background: #2563eb; color: white; border: 0; border-radius: 4px; cursor: pointer; }\n</style>\n</head>\n<body>\n  <form action=\"{{form_action}}\" method=\"POST\">\n    <h1>Sign in</h1>\n    <input name=\"email\" type=\"email\" placeholder=\"Email\" required>\n    <input name=\"password\" type=\"password\" placeholder=\"Password\" required>\n    <button type=\"submit\">Sign in</button>\n  </form>\n</body>\n</html>",
