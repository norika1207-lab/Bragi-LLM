  "code": "<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>Counter</title></head>\n<body>\n  <button id=\"dec\">-</button>\n  <span id=\"v\">0</span>\n  <button id=\"inc\">+</button>\n  <script>\n    let count = 0;\n    const STEP = {{step}};\n    const v = document.getElementById('v');\n    document.getElementById('inc').onclick = () => { count += STEP; v.textContent = count; };\n    document.getElementById('dec').onclick = () => { count -= STEP; v.textContent = count; };\n  </script>\n</body></html>",
