  "code": "<nav class=\"navbar\">\n  <a href=\"/\" class=\"brand\">{{brand_name}}</a>\n  <input type=\"checkbox\" id=\"nav-toggle\" hidden>\n  <label for=\"nav-toggle\" class=\"burger\">&#9776;</label>\n  <ul>\n    <li><a href=\"#features\">Features</a></li>\n    <li><a href=\"#pricing\">Pricing</a></li>\n    <li><a href=\"#docs\">Docs</a></li>\n    <li><a href=\"#contact\">Contact</a></li>\n  </ul>\n</nav>\n<style>\n  .navbar { display: flex; align-items: center; justify-content: space-between; padding: 1rem 2rem; background: white; position: sticky; top: 0; box-shadow: 0 1px 3px rgba(0,0,0,.05); font-family: system-ui; }\n  .navbar .brand { font-weight: 700; text-decoration: none; color: #111; }\n  .navbar ul { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }\n  .navbar a { text-decoration: none; color: #374151; }\n  .burger { display: none; cursor: pointer; font-size: 1.5rem; }\n  @media (max-width: 640px) {\n    .burger { display: block; }\n    .navbar ul { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; background: white; padding: 1rem; }\n    #nav-toggle:checked ~ ul { display: flex; }\n  }\n</style>",
  "language": "html",
